[sub_resource type="GDScript" id="GDScript_0sfw5"]
script/source = "# Fish.gd
extends Node2D

## --- Proprietà Configurabili ---
# !!! MODIFICA: Invece di una Texture, ora esportiamo una risorsa SpriteFrames
@export var animation_frames: SpriteFrames 

@export_group(\"Comportamento\")
@export var speed: float = 100.0
@export var frequency: float = 2.0
@export var amplitude: float = 50.0
# Aggiungiamo il nome dell'animazione da riprodurre
@export var default_animation: StringName = &\"swim\"

@export_group(\"Spawning\")
@export var spawn_weight: float = 1.0 

## --- Nodi Figli ---
# !!! MODIFICA: Puntiamo al nuovo nodo AnimatedSprite2D
@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D

# Variabili interne per il movimento
var time_passed: float = 0.0
var initial_y_position: float

func _ready():
	# !!! MODIFICA: Assegniamo la risorsa e avviamo l'animazione
	if animation_frames:
		animated_sprite.sprite_frames = animation_frames
		animated_sprite.play(default_animation)
	else:
		print(\"ATTENZIONE: Nessuna risorsa SpriteFrames assegnata a questo pesce!\")
		
	initial_y_position = global_position.y

func _process(delta: float):
	# Il codice per il movimento rimane IDENTICO!
	time_passed += delta
	var new_position = global_position
	new_position.x += speed * delta
	new_position.y = initial_y_position + sin(time_passed * frequency) * amplitude
	global_position = new_position
"

